{
  "name": "@eliware/elera-example",
  "version": "13.0.0",
  "type": "module",
  "description": "Runnable Elera client example for routing, telemetry, and graceful lifecycle testing",
  "keywords": [
    "eliware",
    "elera",
    "mysql",
    "mariadb",
    "routing",
    "telemetry",
    "example"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "elera-example": "./bin/elera-example.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    ".env.example"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "pack": "eliware-test --pack",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^12.0.1",
    "@eliware/elera-client": "^13.0.0"
  },
  "devDependencies": {
    "@eliware/test": "^12.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/elera-example.git"
  },
  "homepage": "https://github.com/eliware/elera-example#readme",
  "bugs": {
    "url": "https://github.com/eliware/elera-example/issues"
  },
  "eliware": {
    "id": "E-1324",
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ]
  }
}
